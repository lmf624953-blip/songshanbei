 // Destructor
 //------------------------------------------------------
 InferEngine::~InferEngine() {
+    close();
+}
+
+void InferEngine::close() {
     // Close all workers
     for (auto &worker : workers_) {
         worker->close();
     }
+    // The member declaration order otherwise destroys communication_group_
+    // before workers_. Release model/graph references while it is still alive.
+    workers_.clear();
 }
 
