 namespace infinilm::models::minimax_h3 {
+
+using AdaLNLaunch = void (*)(const infinicore::Tensor &, const infinicore::Tensor &,
+                            const infinicore::Tensor &, const infinicore::Tensor &,
+                            std::uintptr_t);
+
+namespace {
+std::atomic<AdaLNLaunch> fused_adaln{nullptr};
+std::atomic<std::uint64_t> fused_adaln_calls{0};
+} // namespace
+
+extern "C" __attribute__((visibility("default")))
+void songshan_set_adaln_launch(AdaLNLaunch launch) {
+    fused_adaln.store(launch, std::memory_order_release);
+}
+
+extern "C" __attribute__((visibility("default")))
+std::uint64_t songshan_fused_adaln_calls() {
+    return fused_adaln_calls.load(std::memory_order_relaxed);
+}
