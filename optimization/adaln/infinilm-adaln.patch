 infinicore::Tensor apply_adaln(const infinicore::Tensor &normalized,
                                const infinicore::Tensor &scale,
                                const infinicore::Tensor &shift) {
+    auto launch = fused_adaln.load(std::memory_order_acquire);
+    if (launch && normalized->device().getType() == infinicore::Device::Type::HYGON
+        && normalized->dtype() == infinicore::DataType::BF16
+        && scale->dtype() == normalized->dtype() && shift->dtype() == normalized->dtype()
+        && scale->device() == normalized->device() && shift->device() == normalized->device()
+        && normalized->shape().size() == 3 && normalized->shape()[0] == 1
+        && normalized->shape()[1] > 0 && normalized->shape()[2] > 0
+        && scale->shape() == normalized->shape() && shift->shape() == normalized->shape()
+        && !infinicore::context::isGraphRecording()) {
+        auto out = infinicore::Tensor::empty(normalized->shape(), normalized->dtype(),
+                                             normalized->device());
+        launch(out, normalized, scale, shift,
+               reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+        fused_adaln_calls.fetch_add(1, std::memory_order_relaxed);
+        return out;
+    }
     auto scaled = infinicore::op::mul(normalized, scale);
     return infinicore::op::add(infinicore::op::add(normalized, scaled), shift);
