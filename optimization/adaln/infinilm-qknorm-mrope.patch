+// 原始 Q/K -> CUB 顺序 RMSNorm -> BF16 舍入 -> 三轴 MRoPE。
+// 条件不满足时完全交回既有分支，包括 graph recording。
+bool normalize_rotary_heads(infinicore::Tensor &query, infinicore::Tensor &key,
+    const std::shared_ptr<infinicore::nn::RMSNorm> &query_norm,
+    const std::shared_ptr<infinicore::nn::RMSNorm> &key_norm,
+    const infinicore::Tensor &cache, const infinicore::Tensor &positions) {
+    auto launch = qknorm_mrope_launch.load(std::memory_order_acquire);
+    if (!launch || infinicore::context::isGraphRecording()
+        || !supports_packed_heads(query, 0) || !supports_packed_heads(key, 0)
+        || query->shape() != key->shape() || query->device() != key->device()
+        || query_norm->eps() != 1e-5 || key_norm->eps() != 1e-5
+        || cache->device() != query->device() || cache->dtype() != query->dtype()
+        || cache->shape().size() != 2 || cache->shape()[0] == 0
+        || cache->shape()[0] > std::numeric_limits<int>::max() / 96
+        || cache->shape()[1] != 96 || !cache->is_contiguous()
+        || positions->device() != query->device() || positions->dtype() != infinicore::DataType::I64
+        || positions->shape().size() != 1 || positions->shape()[0] != query->shape()[0]
+        || positions->strides()[0] != 1
+        || cache->shape()[0] != query->shape()[0]
+        || reinterpret_cast<std::uintptr_t>(cache->data()) % 16 != 0
+        || reinterpret_cast<std::uintptr_t>(positions->data()) % 16 != 0) return false;
+    auto qw = query_norm->weight();
+    auto kw = key_norm->weight();
+    for (const auto &weight : {qw, kw}) {
+        if (weight->device() != query->device() || weight->dtype() != query->dtype()
+            || weight->shape().size() != 1 || weight->shape()[0] != 128
+            || !weight->is_contiguous() || reinterpret_cast<std::uintptr_t>(weight->data()) % 16 != 0)
+            return false;
+    }
+    auto qout = infinicore::Tensor::empty(query->shape(), query->dtype(), query->device());
+    auto kout = infinicore::Tensor::empty(key->shape(), key->dtype(), key->device());
+    auto cosine = cache->narrow({{1, 0, 48}});
+    auto sine = cache->narrow({{1, 48, 48}});
+    launch(qout, kout, query, key, qw, kw, cosine, sine, positions,
+           reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+    qknorm_mrope_calls.fetch_add(1, std::memory_order_relaxed);
+    query = qout; key = kout;
+    return true;
+}
