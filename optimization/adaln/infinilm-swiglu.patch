+std::optional<infinicore::Tensor> packed_swiglu(
+    const infinicore::Tensor &up, const infinicore::Tensor &gate) {
+    auto launch = swiglu_launch.load(std::memory_order_acquire);
+    constexpr size_t width = 1792;
+    if (!launch || infinicore::context::isGraphRecording()
+        || up->device().getType() != infinicore::Device::Type::HYGON
+        || gate->device() != up->device()
+        || up->dtype() != infinicore::DataType::BF16 || gate->dtype() != up->dtype()
+        || up->shape().size() != 3 || up->shape()[0] != 1 || up->shape()[2] != width
+        || gate->shape() != up->shape() || up->shape()[1] == 0
+        || up->shape()[1] > 2147483647ULL / (2 * width)
+        || up->strides()[1] != 2 * width || gate->strides()[1] != 2 * width
+        || up->strides()[2] != 1 || gate->strides()[2] != 1
+        || reinterpret_cast<std::uintptr_t>(up->data()) % 16 != 0
+        || reinterpret_cast<std::uintptr_t>(gate->data()) % 16 != 0)
+        return std::nullopt;
+    auto output = infinicore::Tensor::empty(up->shape(), up->dtype(), up->device());
+    launch(output, up, gate,
+           reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+    swiglu_calls.fetch_add(1, std::memory_order_relaxed);
+    return output;
+}

