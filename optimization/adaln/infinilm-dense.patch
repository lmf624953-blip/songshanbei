+bool supports_packed_heads(const infinicore::Tensor &input, size_t sequence_axis) {
+    constexpr size_t heads = 7;
+    constexpr size_t width = 128;
+    auto &shape = input->shape();
+    auto &strides = input->strides();
+    return input->device().getType() == infinicore::Device::Type::HYGON
+           && input->dtype() == infinicore::DataType::BF16
+           && shape.size() == sequence_axis + 3 && shape[sequence_axis] > 0
+           && shape[sequence_axis + 1] == heads && shape[sequence_axis + 2] == width
+           && strides[sequence_axis + 1] == width && strides[sequence_axis + 2] == 1
+           && strides[sequence_axis] >= static_cast<ptrdiff_t>(heads * width) && strides[sequence_axis] % 16 == 0
+           && shape[sequence_axis] <= std::numeric_limits<int>::max() / strides[sequence_axis]
+           && reinterpret_cast<std::uintptr_t>(input->data()) % 16 == 0;
+}
+
+infinicore::Tensor normalize_heads(const infinicore::Tensor &x,
+                                   const std::shared_ptr<infinicore::nn::RMSNorm> &norm) {
+    auto launch = qknorm_launch.load(std::memory_order_acquire);
+    if (!launch || !supports_packed_heads(x, 0) || norm->eps() != 1e-5
+        || infinicore::context::isGraphRecording()) {
+        return norm->forward(x);
+    }
+    auto weight = norm->weight();
+    if (weight->dtype() != x->dtype() || weight->device() != x->device()
+        || weight->shape().size() != 1 || weight->shape()[0] != x->shape()[2]
+        || !weight->is_contiguous() || reinterpret_cast<std::uintptr_t>(weight->data()) % 16 != 0) {
+        return norm->forward(x);
+    }
+    auto out = infinicore::Tensor::empty(x->shape(), x->dtype(), x->device());
+    launch(out, x, weight, reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+    qknorm_calls.fetch_add(1, std::memory_order_relaxed);
+    return out;
+}
+
+infinicore::Tensor dense_attention(const infinicore::Tensor &q, const infinicore::Tensor &k,
+                                   const infinicore::Tensor &v, float scale) {
+    auto launch = attention_launch.load(std::memory_order_acquire);
+    if (!launch || !supports_packed_heads(q, 1) || q->shape()[0] != 1 || q->shape()[1] < 4096
+        || !supports_packed_heads(k, 1) || k->shape() != q->shape() || k->device() != q->device()
+        || !supports_packed_heads(v, 1) || v->shape() != q->shape() || v->device() != q->device()
+        || infinicore::context::isGraphRecording()) {
+        return infinicore::op::mha(q, k, v, std::nullopt, scale, false);
+    }
+    auto out = infinicore::Tensor::empty(q->shape(), q->dtype(), q->device());
+    launch(out, q, k, v, scale, reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+    attention_calls.fetch_add(1, std::memory_order_relaxed);
+    return out;
+}
