+bool supports_indexed(const infinicore::Tensor &hidden, const infinicore::Tensor &table,
+                      const infinicore::Tensor &indices) {
+    constexpr size_t width = 5376;
+    constexpr size_t table_stride = 6 * width;
+    const auto &shape = hidden->shape();
+    const auto &table_shape = table->shape();
+    return hidden->device().getType() == infinicore::Device::Type::HYGON
+           && hidden->device() == table->device() && hidden->device() == indices->device()
+           && hidden->dtype() == infinicore::DataType::BF16 && table->dtype() == hidden->dtype()
+           && indices->dtype() == infinicore::DataType::I64
+           && shape.size() == 3 && shape[0] == 1 && shape[2] == width
+           && shape[1] > 0 && shape[1] <= std::numeric_limits<int>::max() / width
+           && indices->shape().size() == 1 && indices->shape()[0] == shape[1]
+           && indices->is_contiguous() && table->is_contiguous() && table_shape.size() == 2
+           && table_shape[0] > 0 && table_shape[0] <= std::numeric_limits<int>::max() / table_stride
+           && table_shape[1] == table_stride && !infinicore::context::isGraphRecording();
+}
+
+infinicore::Tensor apply_indexed(IndexedLaunch launch, bool gate,
+                                 const infinicore::Tensor &first,
+                                 const infinicore::Tensor &second,
+                                 const infinicore::Tensor &table_part,
+                                 const infinicore::Tensor &indices) {
+    auto out = infinicore::Tensor::empty(first->shape(), first->dtype(), first->device());
+    launch(gate, out, first->contiguous(), gate ? second->contiguous() : second, table_part, indices,
+           reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+    indexed_calls.fetch_add(1, std::memory_order_relaxed);
+    return out;
+}
