+std::optional<infinicore::Tensor> normalize_indexed(
+    const infinicore::Tensor &input, const std::shared_ptr<infinicore::nn::RMSNorm> &norm,
+    const infinicore::Tensor &scale, const infinicore::Tensor &shift,
+    const infinicore::Tensor &indices) {
+    auto launch = widenorm_indexed_launch.load(std::memory_order_acquire);
+    constexpr size_t width = 5376;
+    if (!launch || infinicore::context::isGraphRecording() || norm->eps() != 1e-5
+        || input->device().getType() != infinicore::Device::Type::HYGON
+        || input->dtype() != infinicore::DataType::BF16 || input->shape().size() != 3
+        || input->shape()[0] != 1 || input->shape()[2] != width
+        || input->shape()[1] == 0 || input->shape()[1] > std::numeric_limits<int>::max() / width
+        || !input->is_contiguous() || indices->device() != input->device()
+        || indices->dtype() != infinicore::DataType::I64 || !indices->is_contiguous()
+        || indices->shape().size() != 1 || indices->shape()[0] != input->shape()[1])
+        return std::nullopt;
+    auto weight = norm->weight();
+    if (weight->device() != input->device() || weight->dtype() != input->dtype()
+        || weight->shape().size() != 1 || weight->shape()[0] != width || !weight->is_contiguous())
+        return std::nullopt;
+    for (const auto &tensor : {input, weight, indices}) {
+        if (reinterpret_cast<std::uintptr_t>(tensor->data()) % 16 != 0) return std::nullopt;
+    }
+    for (const auto &table : {scale, shift}) {
+        if (table->device() != input->device() || table->dtype() != input->dtype()
+            || table->shape().size() != 3 || table->shape()[0] != 1 || table->shape()[2] != width
+            || table->shape()[1] == 0 || table->shape()[1] > std::numeric_limits<int>::max() / (6 * width)
+            || table->strides()[1] != 6 * width || table->strides()[2] != 1
+            || reinterpret_cast<std::uintptr_t>(table->data()) % 16 != 0)
+            return std::nullopt;
+    }
+    if (scale->shape() != shift->shape()) return std::nullopt;
+    auto output = infinicore::Tensor::empty(input->shape(), input->dtype(), input->device());
+    launch(output, input, weight, scale, shift, indices,
+           reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+    widenorm_indexed_calls.fetch_add(1, std::memory_order_relaxed);
+    return output;
 }
 
