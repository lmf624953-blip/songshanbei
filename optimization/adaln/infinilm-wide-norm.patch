+infinicore::Tensor normalize_wide(const infinicore::Tensor &input,
+                                  const std::shared_ptr<infinicore::nn::RMSNorm> &norm) {
+    auto launch = widenorm_launch.load(std::memory_order_acquire);
+    const auto &shape = input->shape();
+    if (!launch || input->device().getType() != infinicore::Device::Type::HYGON
+        || input->dtype() != infinicore::DataType::BF16 || shape.size() != 3 || shape[0] != 1
+        || shape[1] < 4096 || shape[2] != 5376 || !input->is_contiguous() || norm->eps() != 1e-5
+        || input->numel() > std::numeric_limits<int>::max() || infinicore::context::isGraphRecording()) {
+        return norm->forward(input);
+    }
+    auto weight = norm->weight();
+    if (weight->dtype() != input->dtype() || weight->device() != input->device()
+        || weight->shape().size() != 1 || weight->shape()[0] != 5376 || !weight->is_contiguous()) {
+        return norm->forward(input);
+    }
+    auto output = infinicore::Tensor::empty(shape, input->dtype(), input->device());
+    launch(output, input, weight, reinterpret_cast<std::uintptr_t>(infinicore::context::getStream()));
+    widenorm_calls.fetch_add(1, std::memory_order_relaxed);
+    return output;
 }
 
